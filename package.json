{
  "name": "agent-havik",
  "version": "0.7.0",
  "description": "Which AI agents are on your computer, and what did they touch? Finds Claude Code, Cursor, Codex, Hermes and more, reads their own records locally, and shows the password and key files, secrets and risky scripts; plus a scanner for agent skills, plugins and tool servers",
  "type": "module",
  "bin": {
    "havik": "dist/havik.js"
  },
  "files": [
    "dist/havik.js",
    "dist/guard.js",
    "rules",
    "LICENSE",
    "LICENSE-RULES",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurgarmider/havik.git"
  },
  "homepage": "https://github.com/arthurgarmider/havik#readme",
  "bugs": {
    "url": "https://github.com/arthurgarmider/havik/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "secrets",
    "audit",
    "mcp",
    "privacy",
    "cli"
  ],
  "devDependencies": {
    "@babel/parser": "^7",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ajv": "^8.18.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "smol-toml": "1.9.0",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.2"
  }
}
